# Application
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default, switch to PostgreSQL URL for production)
DATABASE_URL=sqlite:///./society_tracker.db
# DATABASE_URL=postgresql://user:password@localhost:5432/society_tracker

# CORS
FRONTEND_URL=http://localhost:5173

# Email (set MOCK_EMAIL=true to just log to console)
MOCK_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@society.com
FROM_NAME=Society Maintenance Tracker

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
